# ============================================================
# The Code Munk — PRODUCTION Environment
# ============================================================
# INSTRUCTIONS:
#   1. Upload this file to your Hostinger server
#   2. Rename it to  .env  (replace the existing one)
#   3. Fill in your real DB password and App Key
# ============================================================

APP_NAME="The Code Munk"
APP_ENV=production
APP_DEBUG=false

# ── CRITICAL: Empty = site served from domain root (thecodemunk.in)
# If your files are in public_html directly, leave this EMPTY.
# If files are in a sub-folder like public_html/tcm, set: APP_BASE_PATH=/tcm
APP_BASE_PATH=

APP_URL=https://thecodemunk.in
APP_TIMEZONE=Asia/Kolkata

# Generate a strong random string (e.g. 64 chars) and paste here:
# You can generate one at: https://www.random.org/strings/
APP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_64_CHARS

# ── Database (Hostinger hPanel > Databases > MySQL) ──────────
# DB names/users look like:  u123456789_tcm
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_TO_YOUR_DB_NAME
DB_USERNAME=CHANGE_TO_YOUR_DB_USER
DB_PASSWORD=CHANGE_TO_YOUR_DB_PASSWORD
DB_CHARSET=utf8mb4

# ── Session ──────────────────────────────────────────────────
SESSION_NAME=tcm_session
SESSION_LIFETIME=7200

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880

# ── Email (same Gmail SMTP) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=thecodemunk@gmail.com
MAIL_PASSWORD=iijjzxdeamohxfwvt
MAIL_FROM=thecodemunk@gmail.com
MAIL_FROM_NAME="The Code Munk"
MAIL_ADMIN=thecodemunk@gmail.com

# ── Google OAuth ──────────────────────────────────────────────
# IMPORTANT: Add https://thecodemunk.in/auth/google/callback
# to Authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://thecodemunk.in/auth/google/callback

# ── Firebase Push Notifications ──────────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging → Server Key
FCM_SERVER_KEY=

# ── OpenRouter AI (curriculum generator) ─────────────────────────
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
