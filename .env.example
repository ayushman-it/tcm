# ================================================================
# The Code Munk — Environment Configuration
# ================================================================
# HOW TO USE ON HOSTINGER (thecodemunk.in):
#
#   1. Open Hostinger hPanel → File Manager → public_html
#   2. Find the ".env" file (or create it)
#   3. Replace its contents with this template
#   4. Fill in your real DB credentials (from hPanel → Databases)
#   5. Save the file
#
# LOCAL XAMPP: Keep APP_BASE_PATH=/tcm/tcm-2.0 and DB creds as root
# ================================================================

APP_NAME="The Code Munk"
APP_ENV=production
APP_DEBUG=false

# ── BASE PATH ────────────────────────────────────────────────────
# PRODUCTION (thecodemunk.in — files in public_html root): leave EMPTY
# LOCAL XAMPP (subfolder):  APP_BASE_PATH=/tcm/tcm-2.0
APP_BASE_PATH=

APP_URL=https://thecodemunk.in
APP_TIMEZONE=Asia/Kolkata
APP_KEY=GENERATE_A_64_CHAR_RANDOM_STRING_HERE

# ── Database ─────────────────────────────────────────────────────
# Hostinger: hPanel → Databases → MySQL Databases
# Username/DB name format:  u123456789_tcm
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_CHARSET=utf8mb4

# ── Session ──────────────────────────────────────────────────────
SESSION_NAME=tcm_session
SESSION_LIFETIME=7200

# ── Uploads ──────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880

# ── Email (Gmail SMTP) ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=thecodemunk@gmail.com
MAIL_PASSWORD=iijjzxdeamohxfwvt
MAIL_FROM=thecodemunk@gmail.com
MAIL_FROM_NAME="The Code Munk"
MAIL_ADMIN=thecodemunk@gmail.com

# ── OpenRouter AI (TCM Agent + Lesson Content Generation) ────────
# Get your key at: https://openrouter.ai/keys
# Used for BOTH TCM Agent chat AND auto-generating lesson content
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Note: OpenRouter provides access to multiple AI models (GPT-4, Claude, etc.)
# No need for separate Gemini or OpenAI keys!
# IMPORTANT: In Google Cloud Console → APIs → Credentials → Your OAuth client
# Add this to "Authorized redirect URIs":
#   https://thecodemunk.in/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://thecodemunk.in/auth/google/callback
